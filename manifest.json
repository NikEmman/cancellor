{
  "manifest_version": 3,
  "name": "Cancellor",
  "version": "1.0",
  "description": "Adds a browser action icon to the toolbar. Add file and start the automation.",
  "homepage_url": "https://github.com/NikEmman/cancellor",
  "icons": {
    "48": "icons/cancel.png"
  },
  "action": {
    "default_icon": {
      "32": "icons/cancel.png"
    },
    "default_title": "cancellor",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "notifications",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "cancellor@nikemman",
      "strict_min_version": "109.0"
    }
  }
}
